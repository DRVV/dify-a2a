# Dify Configuration
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=your_dify_api_key_here

# Agent-specific Dify Workflow IDs (replace with your actual workflow IDs)
ORCHESTRATOR_WORKFLOW_ID=your_orchestrator_workflow_id
ORCHESTRATOR_API_KEY=your_orchestrator_api_key

RESEARCH_WORKFLOW_ID=your_research_workflow_id
RESEARCH_API_KEY=your_research_api_key

ANALYSIS_WORKFLOW_ID=your_analysis_workflow_id
ANALYSIS_API_KEY=your_analysis_api_key

CODE_WORKFLOW_ID=your_code_workflow_id
CODE_API_KEY=your_code_api_key

# Agent Ports (modify if needed)
ORCHESTRATOR_PORT=9001
RESEARCH_PORT=9002
ANALYSIS_PORT=9003
CODE_PORT=9004

# A2A Configuration
A2A_HOST=0.0.0.0
A2A_LOG_LEVEL=info
