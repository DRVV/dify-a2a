            "code": "import json\nfrom datetime import datetime\n\ndef main(patterns: str, insights: str, recommendations: str, analysis_type: str) -> dict:\n    # Format the complete analysis report\n    \n    report = {\n        \"analysis_metadata\": {\n            \"timestamp\": datetime.now().isoformat(),\n            \"analysis_type\": analysis_type,\n            \"agent\": \"analysis_agent\"\n        },\n        \"executive_summary\": {\n            \"key_findings\": \"Analysis completed successfully\",\n            \"confidence_level\": \"High\",\n            \"data_quality\": \"Good\"\n        },\n        \"detailed_analysis\": {\n            \"patterns_and_trends\": patterns,\n            \"insights_extracted\": insights,\n            \"recommendations\": recommendations\n        },\n        \"next_steps\": [\n            \"Review recommendations with stakeholders\",\n            \"Prioritize implementation based on impact and resources\",\n            \"Establish monitoring and measurement framework\",\n            \"Schedule follow-up analysis as needed\"\n        ]\n    }\n    \n    # Create a formatted summary for easy reading\n    summary = f\"\"\"ANALYSIS REPORT - {analysis_type}\n    \nGenerated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n    \n=== PATTERNS & TRENDS ===\n{patterns}\n    \n=== KEY INSIGHTS ===\n{insights}\n    \n=== RECOMMENDATIONS ===\n{recommendations}\n    \n=== NEXT STEPS ===\n• Review recommendations with stakeholders\n• Prioritize implementation based on impact and resources\n• Establish monitoring and measurement framework\n• Schedule follow-up analysis as needed\n\"\"\"\n    \n    return {\n        \"analysis_report\": json.dumps(report, indent=2),\n        \"formatted_summary\": summary\n    }",
