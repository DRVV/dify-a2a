            "y": 282
          },
          "selected": false,
          "sourcePosition": "right",
          "targetPosition": "left",
          "type": "custom",
          "width": 243
        },
        {
          "data": {
            "code": "import json\nimport re\n\ndef main(analysis_result: str) -> dict:\n    try:\n        # Try to extract JSON from the response\n        json_match = re.search(r'\\{.*\\}', analysis_result, re.DOTALL)\n        if json_match:\n            decision = json.loads(json_match.group())\n        else:\n            # Fallback parsing\n            decision = {\n                \"selected_agents\": [\"research\"],\n                \"reasoning\": \"Default routing due to parsing error\",\n                \"execution_order\": [\"research\"]\n            }\n        \n        # Validate required fields\n        required_fields = [\"selected_agents\", \"reasoning\", \"execution_order\"]\n        for field in required_fields:\n            if field not in decision:\n                decision[field] = [] if field.endswith(\"_agents\") or field.endswith(\"_order\") else \"Not specified\"\n        \n        return {\n            \"routing_decision\": json.dumps(decision, indent=2)\n        }\n    except Exception as e:\n        return {\n            \"routing_decision\": json.dumps({\n                \"selected_agents\": [\"research\"],\n                \"reasoning\": f\"Error parsing decision: {str(e)}\",\n                \"execution_order\": [\"research\"]\n            }, indent=2)\n        }\n",
            "code_language": "python3",
            "desc": "Parse and validate the routing decision from LLM",
            "outputs": {
              "routing_decision": {
                "children": null,
                "type": "string"
              }
            },
            "selected": false,
            "title": "Parse Routing Decision",
