        {
          "data": {
            "code": "import re\nimport ast\n\ndef main(generated_code: str, language: str) -> dict:\n    validation_results = {\n        \"syntax_valid\": False,\n        \"issues_found\": [],\n        \"suggestions\": [],\n        \"complexity_score\": \"Medium\"\n    }\n    \n    try:\n        # Basic syntax validation based on language\n        if language.lower() == \"python\":\n            # Try to parse Python code\n            try:\n                ast.parse(generated_code)\n                validation_results[\"syntax_valid\"] = True\n            except SyntaxError as e:\n                validation_results[\"issues_found\"].append(f\"Python syntax error: {str(e)}\")\n        \n        elif language.lower() in [\"javascript\", \"typescript\"]:\n            # Basic JS/TS validation checks\n            if \"{\" in generated_code and \"}\" in generated_code:\n                validation_results[\"syntax_valid\"] = True\n            else:\n                validation_results[\"issues_found\"].append(\"Missing braces or incomplete function structure\")\n        \n        else:\n            # Generic validation for other languages\n            if len(generated_code.strip()) > 10:\n                validation_results[\"syntax_valid\"] = True\n            else:\n                validation_results[\"issues_found\"].append(\"Code appears too short or incomplete\")\n        \n        # Code quality checks\n        if \"TODO\" in generated_code or \"FIXME\" in generated_code:\n            validation_results[\"suggestions\"].append(\"Code contains TODO/FIXME comments - consider completion\")\n        \n        if len(generated_code.split('\\n')) > 100:\n            validation_results[\"complexity_score\"] = \"High\"\n            validation_results[\"suggestions\"].append(\"Consider breaking down into smaller functions\")\n        elif len(generated_code.split('\\n')) < 20:\n            validation_results[\"complexity_score\"] = \"Low\"\n        \n        # Check for basic documentation\n        if \"def \" in generated_code and '\"\"\"' not in generated_code and \"#\" not in generated_code:\n            validation_results[\"suggestions\"].append(\"Consider adding documentation or comments\")\n        \n    except Exception as e:\n        validation_results[\"issues_found\"].append(f\"Validation error: {str(e)}\")\n    \n    return {\n        \"validation_report\": str(validation_results),\n        \"is_valid\": validation_results[\"syntax_valid\"],\n        \"issue_count\": len(validation_results[\"issues_found\"])\n    }",
            "code_language": "python3",
            "desc": "Validate syntax and code quality",
            "outputs": {
              "validation_report": {
                "children": null,
                "type": "string"
              },
              "is_valid": {
                "children": null,
                "type": "boolean"
              },
              "issue_count": {
