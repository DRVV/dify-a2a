          "data": {
            "code": "import json\nfrom datetime import datetime\n\ndef main(requirements: str, language: str, code_type: str, analysis: str, \n         original_code: str, optimized_code: str, validation: str) -> dict:\n    \n    # Create comprehensive code package\n    code_package = {\n        \"metadata\": {\n            \"timestamp\": datetime.now().isoformat(),\n            \"language\": language,\n            \"code_type\": code_type,\n            \"agent\": \"code_agent\"\n        },\n        \"requirements\": {\n            \"original_request\": requirements,\n            \"technical_analysis\": analysis\n        },\n        \"code_generation\": {\n            \"initial_version\": original_code,\n            \"optimized_version\": optimized_code,\n            \"validation_results\": validation\n        },\n        \"usage_instructions\": [\n            f\"This {code_type} is written in {language}\",\n            \"Review the code before using in production\",\n            \"Adapt variable names and imports as needed\",\n            \"Consider adding unit tests\",\n            \"Follow your project's coding standards\"\n        ]\n    }\n    \n    # Create formatted output\n    formatted_output = f\"\"\"# Generated {code_type} - {language}\n# Created: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n# Requirements: {requirements[:100]}{'...' if len(requirements) > 100 else ''}\n\n## Analysis\n{analysis}\n\n## Final Code\n```{language.lower()}\n{optimized_code}\n```\n\n## Validation Results\n{validation}\n\n## Usage Notes\n- Review and test the code before production use\n- Adapt imports and dependencies for your environment\n- Consider adding error handling specific to your use case\n- Add unit tests to verify functionality\n\"\"\"\n    \n    return {\n        \"code_package\": json.dumps(code_package, indent=2),\n        \"formatted_output\": formatted_output,\n        \"final_code\": optimized_code\n    }",
